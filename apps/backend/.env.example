PORT=5002
HOST=0.0.0.0
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/omsking

JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated browser origins (credentials CORS)
CORS_ORIGIN=http://localhost:5173,https://omsking.codersalpha.com

# Gmail SMTP — Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=you@gmail.com

# AES key for channel API secrets at rest (do not commit real marketplace tokens)
CHANNEL_ENCRYPTION_KEY=change-me-channel-encryption-key

# Phase 1 queue. Redis runs the worker; integration_jobs still stores status.
REDIS_URL=redis://127.0.0.1:6379
# Public HTTPS origin for channel webhooks, no trailing slash. Localhost cannot receive them.
# PUBLIC_BASE_URL=https://omsking.example.com
# Minutes between scheduled Myntra order pulls (0 disables).
# MYNTRA_PULL_MINUTES=15

# Optional local Leheriya connect (never commit filled values)
# MYNTRA_MERCHANT_ID=
# MYNTRA_SECRET_KEY=
# MYNTRA_TOKEN=
# MYNTRA_STORE_ID=
# AMAZON_SELLER_ID=
# AMAZON_REFRESH_TOKEN=
# AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
# AMAZON_PARTNER_ACCOUNT_ID=
# AMAZON_APPLICATION_ID=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_API_SECRET=
# SHOPIFY_SHOP_URL=
# SHOPIFY_ADMIN_TOKEN=
