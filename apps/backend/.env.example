PORT=5002
HOST=0.0.0.0
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/omsking

JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated browser origins (credentials CORS)
CORS_ORIGIN=http://localhost:5173,https://omsking.codersalpha.com

# Developer Support on a development backend always uses the live API (live data): the subscriber inbox signed in
# as this live platform admin. Never commit filled values. The live server itself (NODE_ENV=production) ignores these.
# SUPPORT_LIVE_API_URL=https://omskingapi.codersalpha.com/api/v1
SUPPORT_LIVE_EMAIL=
SUPPORT_LIVE_PASSWORD=
# Live client login whose chat the merchant side of localhost shows (e.g. the Leheriya super admin on live).
SUPPORT_LIVE_CLIENT_EMAIL=
SUPPORT_LIVE_CLIENT_PASSWORD=

# Localhost only: the header "Auto-fix" button starts the Cursor agent CLI on this machine to fix the next Report task.
# Needs `cursor-agent login` once (or CURSOR_API_KEY). Ignored when NODE_ENV=production; never set it on a server.
# REPORT_AUTOFIX=true
# CURSOR_AGENT_BIN=~/.local/bin/cursor-agent
# REPORT_AUTOFIX_MODEL=
# Where the agent's git worktree copies go (default ~/.omsking-autofix, outside the repo).
# REPORT_AUTOFIX_WORKTREES=

# Gmail SMTP — Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=you@gmail.com

# AES key for channel API secrets at rest (do not commit real marketplace tokens)
CHANNEL_ENCRYPTION_KEY=change-me-channel-encryption-key

# Phase 1 queue. Redis runs the worker; integration_jobs still stores status.
REDIS_URL=redis://127.0.0.1:6379
# Public HTTPS origin for channel webhooks, no trailing slash. Localhost cannot receive them.
# PUBLIC_BASE_URL=https://omsking.example.com
# Minutes between scheduled Myntra order pulls (0 disables).
# MYNTRA_PULL_MINUTES=15

# Optional local Leheriya connect (never commit filled values)
# MYNTRA_MERCHANT_ID=
# MYNTRA_SECRET_KEY=
# MYNTRA_TOKEN=
# MYNTRA_STORE_ID=
# AMAZON_SELLER_ID=
# AMAZON_REFRESH_TOKEN=
# AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
# AMAZON_PARTNER_ACCOUNT_ID=
# AMAZON_APPLICATION_ID=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_API_SECRET=
# SHOPIFY_SHOP_URL=
# SHOPIFY_ADMIN_TOKEN=
